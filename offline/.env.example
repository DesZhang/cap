# ── Cap Offline 部署配置 ──────────────────────────────────
# 复制此文件为 .env 并填写实际值。
# 带 (!) 标记的为必填项。

# ── 必填 ────────────────────────────────────────────────

# (!) 管理员密钥，用于管理后台登录。至少 12 个字符。
ADMIN_KEY=

# (!) Redis 集群节点地址，多个节点用逗号分隔。
# 格式：host1:port1,host2:port2,host3:port3
REDIS_CLUSTER_URLS=

# ── 可选 ────────────────────────────────────────────────

# Redis 集群密码（如果集群需要认证）
REDIS_CLUSTER_PASSWORD=

# Redis 集群用户名（如果集群需要认证）
REDIS_CLUSTER_USERNAME=

# Redis 键名前缀（默认：cap:）
REDIS_KEY_PREFIX=cap:

# 验证 token 有效期（毫秒）。默认 7200000（2 小时）。
TOKEN_TTL_MS=

# 获取客户端 IP 的请求头（默认：X-Forwarded-For）
# 如果使用 Nginx 反向代理，建议保持默认值。
RATELIMIT_IP_HEADER=X-Forwarded-For

# API 路径前缀（默认：/cap）
# 修改此值需同步修改反向代理配置和网站集成代码。
BASE_PATH=/cap

# Cap 服务映射到宿主机的端口（默认：3000）
CAP_PORT=3000

# ── 安全固定值（请勿在生产环境修改）──────────────────────

# 是否显示详细错误信息（默认 false，生产环境请保持 false）
# SHOW_ERRORS=false

# 是否禁用错误日志（默认 false，生产环境请保持 false）
# DISABLE_ERROR_LOGGING=false

# 演示模式（默认 false，生产环境请保持 false）
# DEMO_MODE=false
