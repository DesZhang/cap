# Cap Standalone Configuration
# Copy this file to .env and fill in the values.

# ── Required ──────────────────────────────────────────────

# Admin key for the dashboard (minimum 12 characters)
ADMIN_KEY=

# Redis Cluster node URLs (comma-separated ip:port pairs)
REDIS_CLUSTER_URLS=10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379

# Redis Cluster authentication
REDIS_CLUSTER_USERNAME=
REDIS_CLUSTER_PASSWORD=

# ── Recommended ───────────────────────────────────────────

# Header containing the real client IP (set if behind a reverse proxy)
# Common values: X-Forwarded-For, X-Real-IP, CF-Connecting-IP
RATELIMIT_IP_HEADER=X-Forwarded-For

# ── Standalone Redis (alternative to cluster) ─────────────

# If set, uses a single Redis instance instead of cluster mode.
# Comment out REDIS_CLUSTER_* vars when using this.
# REDIS_URL=redis://localhost:6379

# ── Optional ──────────────────────────────────────────────

# Key prefix for all Redis keys (default: cap:)
# Useful when sharing a Redis cluster with other services.
# REDIS_KEY_PREFIX=cap:

# SERVER_PORT=3000
# SERVER_HOSTNAME=0.0.0.0
# SHOW_ERRORS=true
# DISABLE_ERROR_LOGGING=false
# HIDE_RATELIMIT_IP_WARNING=true
# DEMO_MODE=false
